# ── nim_proxy/.env ────────────────────────────────────────────────────────────
# Copy this file as ".env" and fill in your API key.
# Get a free key at: https://build.nvidia.com/settings/api-keys

# [REQUIRED] Your NVIDIA NIM API key
NVIDIA_NIM_API_KEY="nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Model to use. Recommended for code:
#   moonshotai/kimi-k2.5             → fast, 256K context, multimodal
#   moonshotai/kimi-k2-thinking      → advanced reasoning (chain-of-thought)
#   mistralai/devstral-2-123b        → specialized in coding (123B params)
#   minimaxai/minimax-m2.5           → very fast, good for simple tasks
#   z-ai/glm4.7                      → balanced, good tool support
#   z-ai/glm-5.1
#   moonshotai/kimi-k2.6
#
# Full catalog: https://build.nvidia.com/models
NIM_MODEL="moonshotai/kimi-k2.5"

# Port the proxy runs on (8082 by default)
PROXY_PORT=8082
